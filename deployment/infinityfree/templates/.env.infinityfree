APP_NAME="GBU Examination Operations"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://YOUR-DOMAIN.example
APP_TIMEZONE=Asia/Kolkata
SESSION_TIMEOUT_MINUTES=30
SESSION_SAVE_PATH=

# Copy every database value exactly from InfinityFree Control Panel > MySQL Databases.
# InfinityFree's MySQL hostname is not localhost.
DB_HOST=sqlXXX.infinityfree.com
DB_PORT=3306
DB_DATABASE=if0_XXXXXXXX_exam
DB_USERNAME=if0_XXXXXXXX
DB_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
